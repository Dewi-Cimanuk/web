// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. IDENTITY & AUTHENTICATION
// ==========================================

enum Role {
  SUPER_ADMIN
  CONTENT_ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(CONTENT_ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==========================================
// 2. SHARED ENUMS & MODELS
// ==========================================

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  destinations Destination[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ==========================================
// 3. TOURISM CORE DOMAIN
// ==========================================

model Destination {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  priceTicket Decimal?
  openHours   String?
  status      PublishStatus @default(DRAFT)
  
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  
  images      DestinationImage[]
  facilities  Facility[]
  location    Location?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DestinationImage {
  id            String      @id @default(cuid())
  url           String
  isPrimary     Boolean     @default(false)
  
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model Facility {
  id            String      @id @default(cuid())
  name          String
  icon          String?
  
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model Location {
  id            String      @id @default(cuid())
  address       String      @db.Text
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?

  destinationId String      @unique
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. SUPPORTING LOCAL ECONOMY (SPRINT 4)
// ==========================================

model Culinary {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  address     String?
  openHours   String?
  status      PublishStatus @default(DRAFT)
  
  images      CulinaryImage[]
  menus       CulinaryMenu[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CulinaryImage {
  id          String    @id @default(cuid())
  url         String
  isPrimary   Boolean   @default(false)
  culinaryId  String
  culinary    Culinary  @relation(fields: [culinaryId], references: [id], onDelete: Cascade)
}

model CulinaryMenu {
  id          String    @id @default(cuid())
  name        String
  price       Decimal?
  culinaryId  String
  culinary    Culinary  @relation(fields: [culinaryId], references: [id], onDelete: Cascade)
}

model UMKM {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  ownerName   String?
  contact     String?
  address     String?
  status      PublishStatus @default(DRAFT)
  
  images      UMKMImage[]
  products    UMKMProduct[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model UMKMImage {
  id          String    @id @default(cuid())
  url         String
  isPrimary   Boolean   @default(false)
  umkmId      String
  umkm        UMKM      @relation(fields: [umkmId], references: [id], onDelete: Cascade)
}

model UMKMProduct {
  id          String    @id @default(cuid())
  name        String
  price       Decimal?
  umkmId      String
  umkm        UMKM      @relation(fields: [umkmId], references: [id], onDelete: Cascade)
}

model Accommodation {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String        @db.Text
  address       String?
  pricePerNight Decimal?
  contact       String?
  status        PublishStatus @default(DRAFT)
  
  images        AccommodationImage[]
  facilities    AccommodationFacility[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model AccommodationImage {
  id              String         @id @default(cuid())
  url             String
  isPrimary       Boolean        @default(false)
  accommodationId String
  accommodation   Accommodation  @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
}

model AccommodationFacility {
  id              String         @id @default(cuid())
  name            String
  accommodationId String
  accommodation   Accommodation  @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  price       Decimal?
  duration    String?
  status      PublishStatus @default(DRAFT)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
